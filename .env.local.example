# Browser-safe public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secrets. Never expose these to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DODO_PAYMENTS_API_KEY=your-dodo-test-api-key
DODO_WEBHOOK_SECRET=your-dodo-webhook-secret
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_PRODUCT_ID_5=your-dodo-test-product-id-for-5-usd
DODO_PAYMENTS_PRODUCT_ID_9=your-dodo-test-product-id-for-9-usd
CRON_SECRET=replace-with-a-random-secret
